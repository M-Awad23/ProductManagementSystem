@model ProductManagementSystem.Models.User

<h1>My Profile</h1>
<div class="mb-3">
    @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
    {
        <img src="@Model.ProfilePhotoUrl"
             alt="Profile Photo"
             style="width:150px;height:150px;object-fit:cover;" />
    }
</div>

<form id="profilePhotoForm"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="file"
           name="photo"
           accept="image/*"
           class="form-control" />

    <button type="submit"
            class="btn btn-primary mt-2">
        Upload Photo
    </button>
</form>

<div id="profilePhotoMessage"></div>
<div>
    <strong>Email:</strong>
    <span data-user-email>@Model.Email</span>
</div>

<div>
    <strong>Username:</strong>
    @Model.UserName
</div>

<br />

<button type="button"
        id="changeEmailButton"
        class="btn btn-primary">
    Change Email
</button>
<div id="changeEmailContainer"></div>

<button type="button"
        id="changePasswordButton"
        class="btn btn-secondary">
    Change Password
</button>


<div id="changePasswordContainer"></div>

@section Scripts {
    <script src="~/js/account.js"></script>
}