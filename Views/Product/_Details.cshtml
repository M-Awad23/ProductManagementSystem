@model ProductManagementSystem.Models.Product

<div class="product-details">
    @if (Model.ProductImages.Any())
{
    <div class="product-images">
            @foreach (var image in Model.ProductImages.OrderByDescending(i => i.IsPrimary))
            {
                <div class="product-image-item">
                    <button type="button"
                            class="btn btn-secondary"
                            onclick="document.getElementById('replaceImageInput-@image.Id').click()">
                        REPLACE
                    </button>

                    <input type="file"
                           id="replaceImageInput-@image.Id"
                           accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif, image/webp"
                           style="display:none;"
                           onchange="replaceProductImage(@image.Id, this)" />

                    <img src="@image.ImageUrl"
                         class="product-detail-image"
                         alt="@Model.Name" />

                    @if (!image.IsPrimary)
                    {
                        <button type="button"
                                class="btn btn-primary"
                                onclick="setPrimaryImage(@image.Id)">
                            SET PRIMARY
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            PRIMARY
                        </span>
                    }

                    <button type="button"
                            class="btn btn-danger"
                            onclick="deleteProductImage(@image.Id)">
                        DELETE
                    </button>
                </div>
            }
    </div>
}
    <div class="retro-panel-header">
        <h2>PRODUCT DETAILS</h2>
        <p>PRODUCT #@Model.Id</p>
    </div>

    <div class="detail-row">
        <div class="detail-label">Name</div>    
        <div class="detail-value">@Model.Name</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Description</div>
        <div class="detail-value">@Model.Description</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Price</div>
        <div class="detail-value">$@Model.Price</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Quantity</div>
        <div class="detail-value">@Model.Quantity</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Created</div>
        <div class="detail-value">@Model.CreatedAt</div>
    </div>

    <div class="form-actions">

    <a class="btn btn-primary"
       href="@Url.Action("DownloadPdf", "Product", new { id = Model.Id })">
        DOWNLOAD PDF
    </a>

    <button class="btn btn-secondary"
            onclick="closeModal()">
        CLOSE
    </button>

</div>

</div>